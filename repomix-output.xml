<file path=".github/workflows/discord-notify.yml">
name: Discord Notifications

on:
    push:
        branches: ['**'] # 所有 branch
    pull_request:
        types: [opened, synchronize, reopened, closed]
    issues:
        types: [opened, reopened, closed]
    issue_comment:
        types: [created]
    workflow_run:
        workflows: ['*']
        types: [completed]

jobs:
    notify:
        runs-on: ubuntu-latest
        steps:
            - name: Prepare message
              id: prep
              run: |
                  EVENT="${{ github.event_name }}"
                  COLOR=3447003  # blue default
                  TITLE=""
                  DESC=""
                  URL="https://github.com/${{ github.repository }}"

                  # ---------------- PUSH ----------------
                  if [ "$EVENT" = "push" ]; then
                    TITLE="📌 New Push"
                    DESC="**${{ github.actor }}** pushed to **${{ github.ref_name }}**"
                    URL="https://github.com/${{ github.repository }}/commit/${{ github.sha }}"
                    COLOR=3066993  # green
                  fi

                  # ---------------- PR EVENTS ----------------
                  if [ "$EVENT" = "pull_request" ]; then
                    ACTION="${{ github.event.action }}"
                    MERGED="${{ github.event.pull_request.merged }}"
                    PR_URL="${{ github.event.pull_request.html_url }}"
                    PR_TITLE="${{ github.event.pull_request.title }}"

                    if [ "$ACTION" = "closed" ] && [ "$MERGED" = "true" ]; then
                      TITLE="🚀 PR Merged"
                      COLOR=10181046  # purple
                    else
                      TITLE="🔧 Pull Request Updated"
                      COLOR=15844367  # orange
                    fi

                    DESC="**${{ github.actor }}** → ${PR_TITLE}"
                    URL="$PR_URL"
                  fi

                  # ---------------- WORKFLOW RESULT ----------------
                  if [ "$EVENT" = "workflow_run" ]; then
                    STATUS="${{ github.event.workflow_run.conclusion }}"
                    WF_NAME="${{ github.event.workflow_run.name }}"
                    URL="${{ github.event.workflow_run.html_url }}"

                    if [ "$STATUS" = "success" ]; then
                      TITLE="✅ Build Succeeded"
                      COLOR=3066993
                    else
                      TITLE="❌ Build Failed"
                      COLOR=15158332
                    fi

                    DESC="Workflow **$WF_NAME** finished with **$STATUS**"
                  fi

                  # ---------------- ISSUE EVENTS ----------------
                  if [ "$EVENT" = "issues" ]; then
                    ACTION="${{ github.event.action }}"
                    ISSUE_TITLE="${{ github.event.issue.title }}"
                    ISSUE_URL="${{ github.event.issue.html_url }}"

                    if [ "$ACTION" = "opened" ]; then
                      TITLE="🆕 Issue Opened"
                      COLOR=3447003
                    elif [ "$ACTION" = "reopened" ]; then
                      TITLE="♻️ Issue Reopened"
                      COLOR=10181046
                    elif [ "$ACTION" = "closed" ]; then
                      TITLE="✅ Issue Closed"
                      COLOR=3066993
                    fi

                    DESC="**${{ github.actor }}** → ${ISSUE_TITLE}"
                    URL="$ISSUE_URL"
                  fi

                  # ---------------- ISSUE COMMENT ----------------
                  if [ "$EVENT" = "issue_comment" ]; then
                    ISSUE_TITLE="${{ github.event.issue.title }}"
                    COMMENT_URL="${{ github.event.comment.html_url }}"

                    TITLE="💬 New Issue Comment"
                    COLOR=15844367
                    DESC="**${{ github.actor }}** commented on: ${ISSUE_TITLE}"
                    URL="$COMMENT_URL"
                  fi

                  echo "title=$TITLE" >> $GITHUB_OUTPUT
                  echo "desc=$DESC" >> $GITHUB_OUTPUT
                  echo "color=$COLOR" >> $GITHUB_OUTPUT
                  echo "url=$URL" >> $GITHUB_OUTPUT

            - name: Send Discord Embed
              run: |
                  curl -H "Content-Type: application/json" \
                  -X POST \
                  -d "{
                    \"embeds\": [{
                      \"title\": \"${{ steps.prep.outputs.title }}\",
                      \"description\": \"${{ steps.prep.outputs.desc }}\",
                      \"color\": ${{ steps.prep.outputs.color }},
                      \"url\": \"${{ steps.prep.outputs.url }}\",
                      \"footer\": {
                        \"text\": \"${{ github.repository }}\"
                      },
                      \"timestamp\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"
                    }]
                  }" \
                  ${{ secrets.DISCORD_WEBHOOK }}
</file>

<file path="src/composables/useShortcuts.ts">
import { computed, watch } from 'vue';
import { useEventListener, useMagicKeys } from '@vueuse/core';
import { useEditorStore } from '@/store/editorStore';
import { useSelectionStore } from '@/store/selectionStore';
import { useShortcutStore } from '@/store/shortcutStore';

export function useShortcuts() {
    const editorStore = useEditorStore();
    const selectionStore = useSelectionStore();
    const shortcutStore = useShortcutStore();
    const keys = useMagicKeys();

    const isCopy = computed(() => keys['Ctrl+C'].value || keys['Meta+C'].value);
    const isPaste = computed(() => keys['Ctrl+V'].value || keys['Meta+V'].value);
    const isUndo = computed(() => keys['Ctrl+Z'].value || keys['Meta+Z'].value);
    const isRedo = computed(() => keys['Ctrl+Y'].value || keys['Meta+Y'].value);

    watch(
        () => keys.Delete.value,
        (pressed) => {
            if (!pressed) return;
            selectionStore.clearSelection();
            shortcutStore.triggerAction('delete');
        },
    );

    watch(isCopy, (pressed) => pressed && shortcutStore.triggerAction('copy'));
    watch(isPaste, (pressed) => pressed && shortcutStore.triggerAction('paste'));
    watch(isUndo, (pressed) => pressed && shortcutStore.undo());
    watch(isRedo, (pressed) => pressed && shortcutStore.redo());

    useEventListener(window, 'keydown', (event) => {
        if (event.code === 'Space') {
            editorStore.setActiveTool('pan');
        }
    });

    useEventListener(window, 'keyup', (event) => {
        if (event.code === 'Space') {
            editorStore.setActiveTool('select');
        }
    });
}
</file>

